<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The boot log names the network the phone is on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dictation into the prompt (ADR-0070). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ shows the app only the recognizers it asks for. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="saarthi"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Saarthi">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A hub handed over by `saarthi ctl pair`, as a QR code the camera reads. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="saarthi" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Where the camera writes a photo for a prompt (ADR-0071). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- UnifiedPush messages from the distributor (ADR-0026). -->
        <service
            android:name=".Push$Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Allow and Deny on a notification. -->
        <receiver
            android:name=".Push$ActionReceiver"
            android:exported="false" />
    </application>
</manifest>
